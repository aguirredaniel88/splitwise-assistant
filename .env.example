# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API (optional — needed only if you use GPT models)
OPENAI_API_KEY=sk-...

# Default LLM provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic
# Default models (optional — these are the built-in defaults)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o

# Splitwise MCP - path to the splitwise-mcp app.py
SPLITWISE_MCP_PATH=/path/to/splitwise-mcp/app.py

# Splitwise Auth (configure one of these)
SPLITWISE_OAUTH_ACCESS_TOKEN=your_oauth_token
# SPLITWISE_API_KEY=your_api_key

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# App settings
SESSION_TTL_MINUTES=60
PORT=8000
